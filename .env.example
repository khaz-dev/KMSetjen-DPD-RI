# ============================================================================
# ENVIRONMENT MODE
# ============================================================================
ENVIRONMENT=development
DEBUG=False

# ============================================================================
# DJANGO APPLICATION SETTINGS
# ============================================================================
SECRET_KEY=your-super-secret-key-change-in-production-at-least-50-chars
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,django,kms_django,yourdomain.com
DJANGO_SETTINGS_MODULE=config.settings

# ============================================================================
# DATABASE CONFIGURATION (PostgreSQL Only)
# ============================================================================
# Standard credentials (kmsdb, postgres, Okkdpdri@2026)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=kmsdb
DB_USER=postgres
DB_PASSWORD=Okkdpdri@2026
DB_HOST=localhost
DB_PORT=5432

# ============================================================================
# REDIS CONFIGURATION (Cache & Session Store)
# ============================================================================
REDIS_PASSWORD=your-redis-password
REDIS_HOST=localhost
REDIS_PORT=6382
REDIS_URL=redis://:your-redis-password@localhost:6382/0
CACHE_BACKEND=django_redis.cache.RedisCache
CACHE_LOCATION=redis://:your-redis-password@localhost:6382/0
CELERY_BROKER_URL=redis://:your-redis-password@localhost:6382/1
CELERY_RESULT_BACKEND=redis://:your-redis-password@localhost:6382/2

# ==============================================================================
# SSO CONFIGURATION (Optional)
# ==============================================================================
SSO_ENABLED=False
SSO_URL=https://sso.server.com
SSO_CALLBACK_URL=https://yourdomain.com/api/auth/sso/callback

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================
VITE_API_BASE_URL=http://localhost:8002/api
VITE_API_URL=http://localhost:8002
VITE_API_TIMEOUT=30000
VITE_APP_SUBPATH=/kms
FRONTEND_URL=http://localhost:5175

# ============================================================================
# CORS & SECURITY SETTINGS
# ============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:5175,http://127.0.0.1:5175,http://localhost:8002,http://127.0.0.1:8002,https://yourdomain.com
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5175,http://localhost:8002,https://yourdomain.com
SECURE_SSL_REDIRECT=False
DISABLE_SSL_REDIRECT=True

# ============================================================================
# GOOGLE OAUTH 2.0 CONFIGURATION
# ============================================================================
# Get credentials from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5175/kms/google/callback
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ============================================================================
# RECAPTCHA CONFIGURATION
# ============================================================================
# Get credentials from: https://www.google.com/recaptcha/admin
# Use test keys for development (shown below)
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
ENABLE_CAPTCHA=True
VITE_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================
# LOCAL DEVELOPMENT: console backend (prints to console)
# PRODUCTION: SMTP backend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# ============================================================================
# JWT TOKEN SETTINGS
# ============================================================================
JWT_ACCESS_TOKEN_LIFETIME_HOURS=1
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ALGORITHM=HS256

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/django.log

# ============================================================================
# MONITORING & ANALYTICS (Optional)
# ============================================================================
PROMETHEUS_ENABLED=False
DATADOG_ENABLED=False
SENTRY_DSN=
MONITORING_ENABLED=False

# ============================================================================
# FEATURE FLAGS
# ============================================================================
FEATURE_SSO_ENABLED=True
FEATURE_GOOGLE_OAUTH_ENABLED=True
FEATURE_RECAPTCHA_ENABLED=True
FEATURE_BILINGUAL_ENABLED=True
FEATURE_DARK_MODE_ENABLED=True

# ============================================================================
# BACKEND PORT (For local development)
# ============================================================================
BACKEND_PORT=8002

EMAIL_HOST_PASSWORD=your-app-password

# ==============================================================================
# FILE UPLOAD
# ==============================================================================
MAX_UPLOAD_SIZE=2621440  # 2.5MB in bytes
ALLOWED_FILE_EXTENSIONS=pdf,doc,docx,xls,xlsx,jpg,jpeg,png,gif

VITE_SSO_URL=https://nusadpd.duckdns.org