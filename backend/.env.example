# Django Configuration
DJANGO_ENV=dev
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,example.com

# Database
DB_ENGINE=django.db.backends.postgresql
DB_NAME=kms_db
DB_USER=kms_user
DB_PASSWORD=secure_password
DB_HOST=localhost
DB_PORT=5432

# CORS (Frontend URLs)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://kms.example.com

# SSO Configuration
SSO_ENABLED=False
SSO_URL=https://sso.server.com
SSO_CALLBACK_URL=http://localhost:8000/api/auth/sso/callback

# Google OAuth Configuration
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_HERE
GOOGLE_REDIRECT_URI=http://localhost:3000/google/callback

# Email (for notifications)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-password

# Redis (cache & sessions)
REDIS_URL=redis://localhost:6379/0

# File uploads
MAX_UPLOAD_SIZE=52428800
ALLOWED_FILE_EXTENSIONS=pdf,doc,docx,xls,xlsx,jpg,jpeg,png,gif

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/django.log

# JWT Settings
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_LIFETIME_HOURS=1
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
