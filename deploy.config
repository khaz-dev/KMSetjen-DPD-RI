# ============================================================================
# KMSetjen DPD RI - Unified Deployment Configuration
# ============================================================================
# This file defines all deployment settings for all environments
# File location: D:\Project\KMSetjen DPD RI\deploy.config
#
# DO NOT commit sensitive data here - use environment variables
# ============================================================================

# =============================================================================
# DEPLOYMENT ENVIRONMENT CONFIG
# =============================================================================

[environments]
# Define all possible deployment environments
local_dev    = Development (Local - Windows/Mac/Linux)
staging      = Staging (Ubuntu 24.04 - 143.198.200.57)
production   = Production (Ubuntu 24.04 - TBD)

# =============================================================================
# LOCAL DEVELOPMENT ENVIRONMENT
# =============================================================================

[local_dev]
description                 = Local development environment
platform                   = Windows/macOS/Linux
backend_dir                = ./backend
frontend_dir               = ./frontend
backend_url                = http://localhost:8002
frontend_url               = http://localhost:5175
frontend_proxy_port        = 5175
backend_port               = 8002
database_host              = localhost
database_port              = 5432
database_name              = kmsdb
use_docker                 = false
use_gunicorn               = false
deployment_method          = direct_npm_python

# =============================================================================
# STAGING ENVIRONMENT
# =============================================================================

[staging]
description                = Staging environment (https://khaz.app/kms)
platform                   = Linux (Ubuntu 24.04)
server_address             = 143.198.200.57
server_user                = root
deploy_path                = /var/www/html/kmsetjendpdri
backend_dir                = /var/www/html/kmsetjendpdri/backend
frontend_dir               = /var/www/html/kmsetjendpdri/frontend
frontend_dist              = /var/www/html/kmsetjendpdri/frontend/dist
backend_url                = http://django:8002
frontend_url               = http://127.0.0.1:5175
public_url                 = https://khaz.app/kms
frontend_proxy_port        = 5175
backend_port               = 8002
database_host              = localhost
database_port              = 5432
database_name              = kmsdb
use_docker                 = true
use_gunicorn               = true
use_nginx                  = true
deployment_method          = docker_compose
nginx_config_file          = /etc/nginx/sites-available/kms
nginx_enabled_file         = /etc/nginx/sites-enabled/kms
systemd_service            = kmsetjendpdri-gunicorn.service
venv_dir                   = /var/www/html/kmsetjendpdri/venv
python_version             = 3.11
nginx_worker_processes     = auto
gunicorn_workers           = 4
media_path                 = /var/www/html/kmsetjendpdri/backend/media
static_path                = /var/www/html/kmsetjendpdri/backend/staticfiles
custom_domain              = khaz.app
ssl_enabled                = true
ssl_cert_path              = /etc/letsencrypt/live/khaz.app/fullchain.pem
ssl_key_path               = /etc/letsencrypt/live/khaz.app/privkey.pem

# =============================================================================
# PRODUCTION ENVIRONMENT
# =============================================================================

[production]
description                = Production environment
platform                   = Linux (Ubuntu 24.04)
server_address             = TBD
server_user                = root
deploy_path                = /var/www/html/kmsetjendpdri-prod
backend_dir                = /var/www/html/kmsetjendpdri-prod/backend
frontend_dir               = /var/www/html/kmsetjendpdri-prod/frontend
frontend_dist              = /var/www/html/kmsetjendpdri-prod/frontend/dist
backend_url                = http://django:8002
frontend_url               = http://127.0.0.1:5175
public_url                 = https://kmsetjendpdri.dpd.go.id
frontend_proxy_port        = 5175
backend_port               = 8002
database_host              = localhost
database_port              = 5432
database_name              = kmsdb_prod
use_docker                 = true
use_gunicorn               = true
use_nginx                  = true
deployment_method          = docker_compose
nginx_config_file          = /etc/nginx/sites-available/kms-prod
nginx_enabled_file         = /etc/nginx/sites-enabled/kms-prod
systemd_service            = kmsetjendpdri-gunicorn-prod.service
venv_dir                   = /var/www/html/kmsetjendpdri-prod/venv
python_version             = 3.11
nginx_worker_processes     = auto
gunicorn_workers           = 8
media_path                 = /var/www/html/kmsetjendpdri-prod/backend/media
static_path                = /var/www/html/kmsetjendpdri-prod/backend/staticfiles
custom_domain              = kmsetjendpdri.dpd.go.id
ssl_enabled                = true
ssl_cert_path              = /etc/letsencrypt/live/kmsetjendpdri.dpd.go.id/fullchain.pem
ssl_key_path               = /etc/letsencrypt/live/kmsetjendpdri.dpd.go.id/privkey.pem

# =============================================================================
# DEPLOYMENT PHASES & CHECKS
# =============================================================================

[pre_deployment_checks]
# Checks to run BEFORE deployment starts
check_disk_space           = true
check_git_status           = true
check_env_file             = true
check_docker_status        = true
check_database_connection  = true
check_redis_connection     = true
minimum_disk_space_gb      = 5
git_repository             = https://github.com/yourusername/kmsetjendpdri.git

[build_steps]
# Build steps for frontend and backend
install_frontend_deps      = npm install --legacy-peer-deps
build_frontend             = npm run build
install_backend_deps       = pip install -r requirements.txt
collect_static             = python manage.py collectstatic --noinput
migrate_database           = python manage.py migrate --noinput

[deployment_steps]
# Core deployment steps in order
pull_git_repository        = true
backup_current             = true
build_frontend             = true
build_backend              = true
run_migrations             = true
health_check               = true
verify_deployment          = true

[post_deployment_checks]
# Checks to run AFTER deployment
check_services_running     = true
check_database_connection  = true
check_frontend_accessible  = true
check_api_endpoints        = true
check_application_health   = true
smoke_tests_enabled        = true

# =============================================================================
# HEALTH CHECK CONFIGURATION
# =============================================================================

[health_checks]
backend_health_endpoint    = /api/health/
frontend_health_path       = /kms/
max_retries                = 5
retry_interval_seconds     = 3
timeout_seconds            = 10
required_http_status       = 200

# =============================================================================
# BACKUP & ROLLBACK CONFIGURATION
# =============================================================================

[backup_and_recovery]
backup_enabled             = true
backup_location            = ./backups
backup_retention_days      = 14
keep_last_n_backups        = 5
rollback_on_failure        = true
rollback_health_check      = true

# =============================================================================
# NOTIFICATION CONFIGURATION
# =============================================================================

[notifications]
on_success                 = true
on_failure                 = true
slack_webhook_url          = ${SLACK_WEBHOOK_URL}
email_recipients           = ${DEPLOY_EMAIL}

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

[logging]
log_directory              = ./deployment_logs
log_retention_days         = 30
verbose_mode               = false
debug_mode                 = false
log_to_file                = true
log_to_console             = true
